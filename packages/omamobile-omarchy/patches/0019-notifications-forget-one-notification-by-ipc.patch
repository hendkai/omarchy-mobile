# Notifications: forget one notification by IPC. Omarchy Mobile's quick
# settings list the toasts on screen and the history under the sheet, and a
# sideways swipe on a row there takes away that one notification. The
# service has calls for all toasts (dismissAll), all history (clear) and
# toasts by summary text, but none for one entry, and every way a toast
# leaves the screen moves its file into history, so a toast swiped away in
# the shade would come straight back as a history row. Deleting a history
# file from outside isn't safe either: archives, trims and replays run on the
# service's serialized file queue, and a move still queued for that
# notification would put the file back. `forget <timestamp>-<id>.json` now
# closes a toast with that file name (a history replay of it too) at its
# sender without archiving it, then deletes the history entry and its image
# copies on the same queue, after anything already queued. A name that isn't
# a notification file name does nothing.
#
# Against Omarchy 4.0.6 (edge 4.0.6-1) with 0015 and 0017 applied.

# 2026-11-06: per-notification files are gone in 4.5 - live and history are whole-collection JSON. forget now takes the row key, closes the toast without archiving and drops the history entry through the save timer — regenerated against Omarchy 4.5.0-3, same
# semantic change (the previous revision carries the 4.4-era hunks).

diff --git i/shell/plugins/notifications/Service.qml w/shell/plugins/notifications/Service.qml
--- a/shell/plugins/notifications/Service.qml
+++ b/shell/plugins/notifications/Service.qml
@@ -824,8 +824,10 @@
     if (at >= 0) toasts.remove(at)
     delete heights[key]
     delete fresh[key]
-    // A placeholder (the empty-history notice) was never recorded.
-    if (key.indexOf("placeholder") !== 0) storeClose(key, reason)
+    // A placeholder (the empty-history notice) was never recorded. A
+    // forgotten toast (forgetNotification) leaves no history entry
+    // either: its row is dropped, not moved.
+    if (key.indexOf("placeholder") !== 0 && reason !== "forget") storeClose(key, reason)
     layoutRevision += 1
   }
 
@@ -1254,6 +1256,31 @@
     saveSoon("live")
   }
 
+  // Forget one notification for good, named by its key: a toast on screen
+  // with that key, a history replay of it included, closes at its sender
+  // without moving into history, and the history entry goes too. The
+  // history write rides the store's own save timer, after anything
+  // already queued, so a toast that has just left the screen can't come
+  // back as history. A name that is no row's key does nothing.
+  function forgetNotification(name) {
+    var key = String(name || "")
+    if (!key) return "none"
+    var seen = false
+    if (liveKeys[key]) {
+      seen = true
+      closeToast(key, "forget")
+    }
+    var kept = []
+    for (var i = 0; i < historyEntries.length; i++)
+      if (String(historyEntries[i].key) !== key) kept.push(historyEntries[i])
+    if (kept.length !== historyEntries.length) {
+      seen = true
+      historyEntries = kept
+      saveSoon("history")
+    }
+    return seen ? "ok" : "none"
+  }
+
   // Straight to history: a row that closed, or one quiet kept off the screen.
   function storeRecord(row, reason) {
     var now = Date.now() / 1000
@@ -1476,6 +1503,12 @@
     target: "notifications"
 
     function ping(): string { return "ok" }
+
+    // Forget one notification, toast or history entry, by its key
+    // (`forget <key>`); the rest of the history stays.
+    function forget(name: string): string {
+      return service.forgetNotification(name)
+    }
 
     function isDnd(): string { return service.doNotDisturb ? "on" : "off" }
 
