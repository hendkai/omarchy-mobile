# Phone only, not for upstream: omarchy-channel-set and omarchy-refresh-pacman
# refuse on a phone and point at RELEASES.md section 5.4. Both copy Omarchy's
# x86_64 pacman.conf and mirrorlist over the phone's (no [omamobile], no Arch
# Linux ARM) and then upgrade everything from them; the menu offers that as
# Update > Channel, and omarchy-reinstall-pkgs calls the refresh too
# (TOUCH-PLAN 0.2). omamobile-update, which this package installs, is the
# phone's test, as in 0012. omamobile-setup-user hides Update > Channel too;
# this keeps a terminal from doing the same.
#
# Against Omarchy 4.0.6 (stable 4.0.6-1).
# 2026-11-06: insert points moved - channel-set gained trap block, refresh-pacman rewritten around platform templates so wording says templates now — regenerated against Omarchy 4.5.0-3, same
# semantic change (the previous revision carries the 4.4-era hunks).


--- a/bin/omarchy-channel-set
+++ b/bin/omarchy-channel-set
@@ -11,6 +11,16 @@
 trap 'exit 130' INT
 trap 'exit 143' TERM
 
+# Omarchy Mobile: a phone's pacman.conf carries [omamobile] and Arch Linux
+# ARM, which Omarchy's channel templates (omarchy-refresh-pacman) drop.
+if [[ -x /usr/bin/omamobile-update ]]; then
+  echo "omarchy-channel-set: not on an Omarchy Mobile phone. It would replace this phone's" >&2
+  echo "pacman.conf with Omarchy's channel template (no [omamobile], no Arch Linux ARM)" >&2
+  echo "and upgrade everything from it. The phone follows Omarchy's stable channel; update" >&2
+  echo "it with 'omarchy update'. See docs/RELEASES.md section 5.4 in derekross/omarchy-mobile." >&2
+  exit 1
+fi
+
 usage() { echo "Usage: omarchy-channel-set [stable|rc|edge|dev]"; }
 fail() { echo "Error: $*" >&2; exit 1; }
 
--- a/bin/omarchy-refresh-pacman
+++ b/bin/omarchy-refresh-pacman
@@ -5,6 +5,16 @@
 
 set -e
 
+# Omarchy Mobile: a phone's pacman.conf carries [omamobile] and Arch Linux
+# ARM, which Omarchy's pacman/mirrorlist templates would replace.
+if [[ -x /usr/bin/omamobile-update ]]; then
+  echo "omarchy-refresh-pacman: not on an Omarchy Mobile phone. It would replace this phone's" >&2
+  echo "pacman.conf and mirrorlist with Omarchy's templates (no [omamobile], no Arch Linux" >&2
+  echo "ARM) and upgrade everything from them. Update the phone with 'omarchy update'." >&2
+  echo "See docs/RELEASES.md section 5.4 in derekross/omarchy-mobile." >&2
+  exit 1
+fi
+
 channel="${1:-}"
 if [[ -n $channel && $channel != "stable" && $channel != "rc" && $channel != "edge" ]]; then
   echo "Invalid channel: $channel" >&2
