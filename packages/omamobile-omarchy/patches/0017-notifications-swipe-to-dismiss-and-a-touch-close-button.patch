# Notifications: swipe to dismiss, and a close button on touch screens. On a
# touch screen a tap runs the toast's default action and there is no right
# button, so a toast could only be got rid of by letting it launch something,
# and a critical one (Omarchy's first-run invitations) never expires. A
# sideways swipe now moves the card with the finger: let go past 35% of its
# width, or flick it, and it flies off that side and closes as a right-click
# does; short of that it springs back. The drag starts only past a threshold,
# so a tap still runs the default action, and it is off while a reply is
# being typed. When Hyprland lists a touch screen, each toast also gets a
# close glyph with a 44 px target in its top-right corner; a seat with only a
# mouse shows none, so desktops look as before. Hover pauses the countdown
# for a mouse or stylus only (a finger doesn't hover), and a card being
# swiped doesn't expire under the finger. Right-click still closes.
#
# Against Omarchy 4.0.6 (edge 4.0.6-1) with 0015 (inline reply) applied.

# 2026-11-06: rewritten into Toast.qml cards - swipe rides x offset with plate and content fade, held keeps the countdown off, touch close button beside the headline stamp. 4.5 has no hover pause so the HoverHandler device tweak has no counterpart — regenerated against Omarchy 4.5.0-3, same
# semantic change (the previous revision carries the 4.4-era hunks).

diff --git i/shell/plugins/notifications/Service.qml w/shell/plugins/notifications/Service.qml
--- a/shell/plugins/notifications/Service.qml
+++ b/shell/plugins/notifications/Service.qml
@@ -1361,6 +1361,29 @@
     onLoadFailed: service.loadQuiet("")
   }
 
+  // Whether the seat has a touch screen, asked of Hyprland once at startup.
+  // Toasts then show a close button and take swipes: a tap runs the default
+  // action, and a finger has no right button to dismiss with. A seat with
+  // only a mouse keeps the toasts as they were.
+  property bool touchScreen: false
+
+  Process {
+    id: touchScreenProc
+    command: ["hyprctl", "-j", "devices"]
+    running: false
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        try {
+          var touch = JSON.parse(text || "{}").touch
+          service.touchScreen = Array.isArray(touch) && touch.length > 0
+        } catch (e) {
+          service.touchScreen = false
+        }
+      }
+    }
+  }
+
   // Once at startup: the private directory and its files. Older layouts'
   // leftovers are removed by a migration.
   Process {
@@ -1378,7 +1401,10 @@
     onExited: function(code) { service.storeReady = code === 0 }
   }
 
-  Component.onCompleted: storePrepare.running = true
+  Component.onCompleted: {
+    storePrepare.running = true
+    touchScreenProc.running = true
+  }
   // A reload or a clean exit inside the save delay still writes.
   Component.onDestruction: flushStore()
 
@@ -1689,6 +1715,7 @@
               selected: service.keyboardMode && service.keyboardKey === model.key
               actions: service.actionsOf(model.key, service.refsRevision)
               replyPlaceholder: service.replyPlaceholderFor(model.key, service.refsRevision)
+              closeButtonShown: service.touchScreen
               hoverX: service.hoverX
               hoverY: service.hoverY
               // A click is the mouse taking over: it ends keyboard mode, which
diff --git i/shell/plugins/notifications/Toast.qml w/shell/plugins/notifications/Toast.qml
--- a/shell/plugins/notifications/Toast.qml
+++ b/shell/plugins/notifications/Toast.qml
@@ -103,6 +103,23 @@
   }
   Component.onDestruction: if (replying && scene) scene.openReplies -= 1
 
+  // The card is under the user's hand: a finger swiping it. The countdown
+  // waits meanwhile, so a card under a finger never expires.
+  readonly property bool held: swipeHandler.active
+
+  // Touch: a horizontal swipe dismisses (swipeEnabled), and a close button
+  // shows in the top-right corner (closeButtonShown), as a tap runs the
+  // default action and a touch screen has no right button. The scene shows
+  // the button when the seat has a touch screen, so a mouse-only desktop
+  // looks and behaves as before.
+  property bool swipeEnabled: true
+  property bool closeButtonShown: false
+  // How far the card has been swiped sideways, in pixels.
+  property real swipeOffset: 0
+  // Release speed of the last swipe, pixels per second.
+  property real swipeVelocity: 0
+  property bool dismissing: false
+
   readonly property bool critical: row.urgency === 2
   readonly property color dimColor: Qt.darker(Commons.Color.notifications.text, 1.4)
   readonly property color bodyColor: Qt.darker(Commons.Color.notifications.text, 1.15)
@@ -166,6 +183,23 @@
     return out
   }
 
+  // A swipe ends: past 35% of the width, or flicked fast enough the same
+  // way, the card flies off that side and closes; otherwise it springs back.
+  function finishSwipe() {
+    var distance = Math.abs(swipeOffset)
+    var sameWay = swipeVelocity * swipeOffset > 0
+    var flung = sameWay && Math.abs(swipeVelocity) >= Style.space(900) && distance >= width * 0.1
+    if (width > 0 && (distance >= width * 0.35 || flung)) {
+      dismissing = true
+      swipeAnimation.to = (swipeOffset < 0 ? -1 : 1) * (width + Style.space(24))
+      swipeAnimation.dismiss = true
+    } else {
+      swipeAnimation.to = 0
+      swipeAnimation.dismiss = false
+    }
+    swipeAnimation.restart()
+  }
+
   function doDeed(deed) {
     var kind = String(deed.kind || "")
     if (kind === "action") { actionInvoked(String(deed.value)); return }
@@ -184,7 +218,7 @@
   // time, and gets a fresh display period of its own duration. Its picture
   // may be new at the same path, so the image is read again too.
   property real remaining: Number(row.duration || 0)
-  readonly property bool ticking: Number(row.duration || 0) > 0 && !paused && !replying
+  readonly property bool ticking: Number(row.duration || 0) > 0 && !paused && !replying && !held
   readonly property string arrival: String(row.ts) + ":" + String(row.duration)
   property bool reloading: false
   onArrivalChanged: {
@@ -207,6 +241,9 @@
 
   width: cardWidth
   height: body.height
+  // The swipe moves the card sideways; the card's own opacity belongs to
+  // the scene's layout, so the fade rides the plate and the content.
+  x: swipeOffset
 
   LayoutMirroring.enabled: Commons.I18n.rightToLeft
   LayoutMirroring.childrenInherit: true
@@ -262,6 +299,7 @@
     id: plate
     width: body.width
     height: body.height
+    opacity: 1 - 0.6 * Math.min(1, Math.abs(card.swipeOffset) / Math.max(1, card.width))
     radius: Style.cornerRadius
     color: Commons.Color.notifications.background
     borderSpec: Border.surfaceSpec("notifications", "border", Commons.Color.notifications.border,
@@ -281,6 +319,7 @@
     id: body
     width: parent.width
     height: card.drawnHeight
+    opacity: 1 - 0.6 * Math.min(1, Math.abs(card.swipeOffset) / Math.max(1, card.width))
 
     Row {
       id: layout
@@ -432,6 +471,7 @@
             anchors.verticalCenter: parent.verticalCenter
             width: Math.max(1, parent.width - rightSide.width
                    - (titleMarks.visible ? titleMarks.width + Style.space(7) : 0)
+                   - (card.closeButtonShown ? Style.space(44) : 0)
                    - Style.space(8))
             text: card.redacted ? I18n.t("notifications.redactedSummary") : String(card.row.summary || "")
             color: Commons.Color.notifications.text
@@ -471,6 +511,7 @@
           Row {
             id: rightSide
             anchors.right: parent.right
+            anchors.rightMargin: card.closeButtonShown ? Style.space(44) : 0
             anchors.verticalCenter: title.verticalCenter
             spacing: Style.space(5)
 
@@ -690,7 +731,98 @@
           // throw the reply away.
           if (!card.replying) card.activated()
         } else card.dismissed()
+      }
+    }
+
+    // Swipe to dismiss. Only sideways movement past the threshold starts
+    // it, so a tap still runs the default action and a right-click still
+    // closes. Off while a reply is being typed, so selecting text can't
+    // throw the reply away.
+    DragHandler {
+      id: swipeHandler
+      target: null
+      yAxis.enabled: false
+      dragThreshold: Style.space(12)
+      enabled: card.swipeEnabled && !card.replying && !card.dismissing
+      onActiveChanged: {
+        if (active) {
+          swipeAnimation.stop()
+          card.swipeVelocity = 0
+        } else {
+          card.finishSwipe()
+        }
+      }
+      onActiveTranslationChanged: {
+        if (!active) return
+        card.swipeOffset = activeTranslation.x
+        card.swipeVelocity = centroid.velocity.x
       }
     }
+
+    SequentialAnimation {
+      id: swipeAnimation
+      property real to: 0
+      property bool dismiss: false
+      NumberAnimation {
+        target: card
+        property: "swipeOffset"
+        to: swipeAnimation.to
+        duration: swipeAnimation.dismiss ? 140 : 200
+        easing.type: swipeAnimation.dismiss ? Easing.InQuad : Easing.OutBack
+      }
+      ScriptAction {
+        script: {
+          if (!swipeAnimation.dismiss) return
+          card.dismissed()
+          // A container that keeps the card (nothing removes it) gets it
+          // back.
+          swipeResetTimer.restart()
+        }
+      }
+    }
+
+    Timer {
+      id: swipeResetTimer
+      interval: 400
+      onTriggered: {
+        card.dismissing = false
+        card.swipeOffset = 0
+      }
+    }
+
+    // Close button for touch: a small glyph with a 44 px target in the
+    // top-right corner, inside the border. A seat with only a mouse shows
+    // none (the hover close mark serves it), so desktops look as before.
+    MouseArea {
+      id: closeButton
+      objectName: "notificationCloseButton"
+      visible: card.closeButtonShown
+      anchors.top: parent.top
+      anchors.right: parent.right
+      anchors.topMargin: plate.borderTop
+      anchors.rightMargin: plate.borderRight
+      width: Style.space(44)
+      height: Style.space(44)
+      cursorShape: Qt.PointingHandCursor
+      onClicked: card.dismissed()
+
+      Rectangle {
+        anchors.centerIn: parent
+        width: Style.space(28)
+        height: width
+        radius: width / 2
+        color: Commons.Color.notifications.text
+        opacity: closeButton.pressed ? 0.18 : 0
+      }
+
+      Text {
+        textFormat: Text.PlainText
+        anchors.centerIn: parent
+        text: "✕"
+        color: card.dimColor
+        font.family: "Liberation Sans"
+        font.pixelSize: Style.font.title
+      }
+    }
   }
 }
