+
+  // Inline reply (the freedesktop `inline-reply` action): the scene sets the
+  // sender's placeholder text while the live notification takes a reply. The
+  // history replay leaves it empty: a stored notification can't be answered.
+  property string replyPlaceholder: ""
+  // The reply field is open. The scene keeps the surface's keyboard focus and
+  // stops the countdown meanwhile.
+  property bool replying: false
+  signal replyRequested()
+  signal replySent(string text)
+  signal replyCancelled()
+
+  function sendReply() {
+    var text = replyField.text
+    if (text.trim().length === 0) return
+    card.replySent(text)
+  }
+
+  onReplyPlaceholderChanged: if (replyPlaceholder.length === 0) replying = false
+
+  // The scene counts open fields: while any is, the toast surface takes
+  // keyboard focus, so an on-screen keyboard can type into it. A field that
+  // opens gets focus; one that closes forgets what was typed and gets a
+  // fresh countdown, so the toast doesn't vanish the moment the field closes.
+  onReplyingChanged: {
+    if (scene) scene.openReplies += replying ? 1 : -1
+    if (replying) Qt.callLater(function() { replyField.forceActiveFocus() })
+    else {
+      replyField.text = ""
+      remaining = Number(row.duration || 0)
+    }
+  }
+  Component.onDestruction: if (replying && scene) scene.openReplies -= 1
 
