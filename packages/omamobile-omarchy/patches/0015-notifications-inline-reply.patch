+
+  // ------------------------------------------------------- inline reply
+  //
+  // The freedesktop `inline-reply` action, which Quickshell implements: a
+  // toast whose sender asked for it gets a Reply button that opens a field
+  // with Send and Cancel (Toast.qml). Stored rows have no live sender and
+  // get none of this.
+
+  // The live notification behind a toast, or null. A restored row has none.
+  function liveRefFor(key) {
+    var ref = refs[key]
+    if (!ref) return null
+    try {
+      return ref.tracked ? ref : null
+    } catch (e) {
+      return null
+    }
+  }
+
+  // The reply field's placeholder for a toast whose sender asked for an
+  // inline reply, or "" when it can't take one. The revision re-runs this
+  // when a sender's update adds or drops the action.
+  function replyPlaceholderFor(key, revision) {
+    var ref = liveRefFor(key)
+    if (!ref || !ref.hasInlineReply) return ""
+    return String(ref.inlineReplyPlaceholder || "") || "Reply"
+  }
+
+  // Toasts with the reply field open. While any is, the toast surface takes
+  // keyboard focus so an on-screen keyboard can type into the field.
+  property int openReplies: 0
+
+  // Send the reply to its sender (NotificationReplied), then take the toast
+  // off the screen. A sender that has meanwhile closed the notification
+  // gets nothing; the toast opens its app instead, so the reply isn't lost
+  // silently.
+  function sendReply(key, text) {
+    var ref = liveRefFor(key)
+    if (!ref || !ref.hasInlineReply) {
+      activate(key)
+      return
+    }
+    try {
+      ref.sendInlineReply(text)
+    } catch (e) {
+      console.warn("inline reply failed:", e)
+      activate(key)
+      return
+    }
+    closeToast(key, "dismissed")
   }
 
