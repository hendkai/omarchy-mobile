@@ -0,0 +1,202 @@
+// A notification card for the lock's glance view: a static summary of a
+// stored row (the app, the summary, the body capped at a few lines, the
+// age), with the swipe-to-dismiss math of the toasts (0017's finishSwipe)
+// driven by the glance's own touch area, which also handles taps. Omarchy
+// 4.5's notifications plugin has no shared card component (the deck's
+// Toast.qml is bound to its scene), so the glance carries its own.
+
+import QtQuick
+import qs.Commons
+import qs.Commons as Commons
+import qs.Ui
+
+Item {
+  id: card
+
+  property string app: ""
+  property string appIcon: ""
+  property string image: ""
+  property string glyph: ""
+  property int urgency: 1
+  property double timestamp: 0
+  property string summary: ""
+  property string body: ""
+  // A static summary keeps each card short, and the detail line under the
+  // body says how old it is ("5m").
+  property int summaryLines: 2
+  property int bodyLines: 3
+  property string detail: ""
+  property int cornerRadius: 0
+  property string fontFamily: ""
+
+  // The swipe, moved by the glance's touch area: let go past 35% of the
+  // width, or flicked, and the card flies off that side and asks to close;
+  // short of that it springs back.
+  property real swipeOffset: 0
+  property real swipeVelocity: 0
+  property bool dismissing: false
+  // A swipe that carried the card off its side: the owner forgets it.
+  signal dismissed()
+
+  function finishSwipe() {
+    var distance = Math.abs(swipeOffset)
+    var sameWay = swipeVelocity * swipeOffset > 0
+    var flung = sameWay && Math.abs(swipeVelocity) >= Style.space(900) && distance >= width * 0.1
+    if (width > 0 && (distance >= width * 0.35 || flung)) {
+      dismissing = true
+      swipeAnimation.to = (swipeOffset < 0 ? -1 : 1) * (width + Style.space(24))
+      swipeAnimation.dismiss = true
+    } else {
+      swipeAnimation.to = 0
+      swipeAnimation.dismiss = false
+    }
+    swipeAnimation.restart()
+  }
+
+  readonly property color dimColor: Qt.darker(Commons.Color.notifications.text, 1.4)
+  readonly property color bodyColor: Qt.darker(Commons.Color.notifications.text, 1.15)
+  readonly property color accentColor: urgency === 2 ? Commons.Color.urgent
+    : (urgency === 0 ? dimColor : Commons.Color.notifications.countdown)
+
+  x: swipeOffset
+  opacity: 1 - 0.6 * Math.min(1, Math.abs(swipeOffset) / Math.max(1, width))
+
+  implicitHeight: plate.borderTop + plate.borderBottom + contentRow.height + contentRow.y * 2
+  height: implicitHeight
+
+  BorderSurface {
+    id: plate
+    width: parent.width
+    height: parent.height
+    radius: card.cornerRadius
+    color: Commons.Color.notifications.background
+    borderSpec: Border.surfaceSpec("notifications", "border", Commons.Color.notifications.border,
+                                   Math.max(1, Style.space(2)))
+  }
+
+  Row {
+    id: contentRow
+    width: parent.width - plate.borderLeft - plate.borderRight - Style.space(24)
+    x: plate.borderLeft + Style.space(12)
+    y: plate.borderTop + Style.space(10)
+    spacing: Style.space(10)
+
+    // The sender's picture, else the glyph an Omarchy sender asked for,
+    // else the app's first letter.
+    Item {
+      id: thumb
+      width: card.image.length > 0 || card.glyph.length > 0 || card.app.length > 0 ? Style.space(40) : 0
+      height: width
+      visible: width > 0
+      anchors.verticalCenter: parent.verticalCenter
+
+      Rectangle {
+        visible: card.image.length === 0 && card.glyph.length === 0
+        anchors.fill: parent
+        radius: Style.cornerRadius
+        color: Style.normalFillFor(Commons.Color.notifications.text, card.accentColor, Commons.Color.urgent)
+
+        Text {
+          textFormat: Text.PlainText
+          anchors.centerIn: parent
+          text: card.app.substring(0, 1).toUpperCase()
+          color: card.dimColor
+          font.family: card.fontFamily
+          font.pixelSize: Style.font.body
+          font.weight: Font.DemiBold
+        }
+      }
+
+      Text {
+        textFormat: Text.PlainText
+        anchors.centerIn: parent
+        visible: card.image.length === 0 && card.glyph.length > 0
+        text: card.glyph
+        color: Commons.Color.notifications.text
+        font.family: card.fontFamily
+        font.pixelSize: Style.font.displayLarge
+      }
+
+      Image {
+        anchors.fill: parent
+        visible: card.image.length > 0
+        source: card.image
+        fillMode: Image.PreserveAspectCrop
+        asynchronous: true
+      }
+    }
+
+    Column {
+      id: contentCol
+      width: parent.width - (thumb.visible ? thumb.width + parent.spacing : 0)
+      spacing: Style.space(3)
+
+      Text {
+        width: parent.width
+        textFormat: Text.PlainText
+        visible: card.summary.length > 0
+        text: card.summary
+        color: Commons.Color.notifications.text
+        font.family: "Liberation Sans"
+        font.pixelSize: Style.font.title
+        font.bold: true
+        wrapMode: Text.WordWrap
+        elide: Text.ElideRight
+        maximumLineCount: card.summaryLines
+      }
+
+      Text {
+        width: parent.width
+        textFormat: Text.PlainText
+        visible: card.body.length > 0
+        text: card.body
+        color: card.bodyColor
+        font.family: "Liberation Sans"
+        font.pixelSize: Style.font.title
+        wrapMode: Text.WordWrap
+        elide: Text.ElideRight
+        maximumLineCount: card.bodyLines
+      }
+
+      Text {
+        width: parent.width
+        textFormat: Text.PlainText
+        visible: card.detail.length > 0
+        text: card.detail
+        color: card.dimColor
+        font.family: card.fontFamily
+        font.pixelSize: Style.font.bodySmall
+      }
+    }
+  }
+
+  SequentialAnimation {
+    id: swipeAnimation
+    property real to: 0
+    property bool dismiss: false
+    NumberAnimation {
+      target: card
+      property: "swipeOffset"
+      to: swipeAnimation.to
+      duration: swipeAnimation.dismiss ? 140 : 200
+      easing.type: swipeAnimation.dismiss ? Easing.InQuad : Easing.OutBack
+    }
+    ScriptAction {
+      script: {
+        if (!swipeAnimation.dismiss) return
+        card.dismissing = true
+        card.dismissed()
+        swipeResetTimer.restart()
+      }
+    }
+  }
+
+  Timer {
+    id: swipeResetTimer
+    interval: 400
+    onTriggered: {
+      card.dismissing = false
+      card.swipeOffset = 0
+    }
+  }
+}
