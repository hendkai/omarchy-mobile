# Lock: a glance view on touch-only devices (the lock-keypad toggle), as a
# phone's lock screen opens: the time, the date, the home screen's last
# weather reading and the newest notifications, over the lock's blurred
# wallpaper. Only a swipe up (a clear drag, 8 % of the height, or a quick
# flick, from anywhere, a card included) or a typed key (kept in the field)
# moves to the PIN view, which is the lock as before plus a small clock. A
# tap never does: a tap on a card opens it to more of its text (summary up
# to 2 lines, body up to 4) and runs nothing, a second tap closes it, and a
# tap elsewhere does nothing. The first 12 px of a drag decide its way:
# mostly sideways on a card swipes it as a toast swipes (0017's
# finishSwipe: past 35 % or a flick it flies off), and that one notification
# is forgotten through the notifications service's forget call (0019), the
# call the phone's shade makes, so it leaves the history and the shade too,
# and the next one moves up; mostly vertical is the swipe up. It comes back
# whenever the lock is shown, the
# screen is woken (the wake call from 0009) or the screen goes dark: the
# lock's own blank, or a new "dark" call for what blanks it from outside
# (the phone's power button, and sleep). With an empty field and no input it
# also comes back after 15 s, counted on the wall clock so that a sleep in
# between can't freeze it. A touch on a dark screen, and one within 400 ms
# of a wake, only wakes it, and open cards close again. Only one view shows
# outside the short change; the other is hidden, so nothing of the PIN view
# renders or takes touches under the glance. Fingerprint unlock is untouched
# and works from both.
#
# The cards are Omarchy's NotificationCard, static as the history uses it,
# one per notification, newest first, as many as fit above the hint (up to
# three), then a line for the rest ("N more from A and B", "N more from A,
# B and 2 others"), with three new card properties: summaryLines, bodyLines
# and a detail label (the age, "2m").
# Read (the forget is the one change) from the notifications plugin's
# persisted toasts and history
# (~/.local/state/omarchy/notifications/*.json, history/*.json): the same
# notifications the phone's shade lists, the newest ten with no age limit,
# Omarchy's own messages (omarchy-action, shown as Omarchy) and notify-send
# included. While do-not-disturb is on (notifications.json "dnd"), only what
# still toasts shows: Omarchy's own messages and a critical notify-send.
# The toggle lock-hide-notification-text shows the app name and "Unlock to
# read" instead of the text. Weather comes from
# ~/.local/state/omamobile/weather.json, written by the phone shell's
# omamobile-weather service, and is hidden when absent or over 3 h old; the
# lock makes no network calls. The clock is 12- or 24-hour as the phone bar
# and the home screen's clock decide, from the bar's clockFormat (shell.json,
# read at once whatever the lock shows, on every change and whenever the
# glance comes back; a failed read keeps the last), else the bar's default
# (HH:mm), never the session's C/POSIX locale. The big glance time is built
# without AM/PM (Qt's "h" without a marker counts to 23), the small clock
# over the PIN view keeps it. On a computer the lock is unchanged.
#
# Against Omarchy 4.0.6 (edge 4.0.6-1), after 0003, 0009, 0011, 0014, 0017
# and 0019.

# 2026-11-06: per-notification files are gone in 4.5 - live and history are whole-collection JSON. forget now takes the row key, closes the toast without archiving and drops the history entry through the save timer — regenerated against Omarchy 4.5.0-3, same

# 2026-11-06: LockView kept its shape so its hunks re-anchor. Data layer rewritten for 4.5 store - live.json plus history.json arrays and quiet.json - with the row key as the card identity matching the forget call. NotificationCard is gone so the glance carries LockGlanceCard.qml with the 4.4 card look and 0017 swipe math — regenerated against Omarchy 4.5.0-3, same

# 2026-11-06: wake bumps wakeSerial again and the dark IPC call is back — omamobile-keys' power button and omamobile-sleepd call it, and the glance returns on a wake. Regenerated against Omarchy 4.5.0-3, same
# semantic change (the previous revision carries the 4.4-era hunks).

--- /dev/null
+++ b/shell/plugins/lock/LockGlance.js
@@ -0,0 +1,212 @@
+// What the phone's lock shows at a glance (LockGlance.qml): the clock's
+// 12- or 24-hour choice, the notifications grouped by app, and the weather
+// line. Plain functions of their inputs, so the test can drive them.
+//
+// Omarchy 4.5's notifications store: live.json and history.json, each one
+// JSON array on a single line (Store.serialise), and quiet.json's {dnd}.
+// A card's identity is the row key, the same name the notifications
+// service's forget call takes.
+
+// Up to this many notifications get a card; the rest fold into one line.
+var MAX_CARDS = 3
+// The notifications the lock sums up are the ones the phone's notification
+// shade lists: the newest ten of the toasts on screen and the history, with
+// no age limit and no app left out.
+var SHADE_LIMIT = 10
+// NotificationUrgency.Critical, for the do-not-disturb rule.
+var CRITICAL = 2
+// A weather reading older than this is not shown.
+var WEATHER_MAX_AGE_MS = 3 * 60 * 60 * 1000
+
+// The bar's own default time format (omamobile-shell's bar, without a
+// clockFormat): the lock's clock agrees with it.
+var BAR_DEFAULT_FORMAT = "HH:mm"
+
+// 12- or 24-hour, decided as the phone bar and the home screen's clock decide
+// (omamobile-shell, HomeModel.systemTimeFormat) from the bar's clockFormat
+// (shell.json bar.clockFormat): quoted literals ignored, an AM/PM marker or
+// "h" without "H" means 12-hour. Without one, the bar's default (24-hour),
+// never the session's Qt locale, which is C/POSIX for the shell.
+function twelveHour(barFormat) {
+  var f = String(barFormat || BAR_DEFAULT_FORMAT).replace(/'[^']*'/g, "")
+  return /a/i.test(f) || (/h/.test(f) && !/H/.test(f))
+}
+
+// The bar's clockFormat from shell.json's text: "" when it has none, null
+// when the text can't be read (a write caught half done), which keeps the
+// last one.
+function barClockFormat(text) {
+  var shell
+  try { shell = JSON.parse(String(text || "")) } catch (e) { return null }
+  if (!shell || typeof shell !== "object") return null
+  return shell.bar && shell.bar.clockFormat ? String(shell.bar.clockFormat) : ""
+}
+
+// The small clock over the PIN view: a Qt format, with AM/PM in 12-hour.
+function timeFormat(twelve) {
+  return twelve ? "h:mm AP" : "HH:mm"
+}
+
+// The large glance time, without AM/PM. Built here, not as the Qt format
+// "h:mm": without an AM/PM marker in the same format Qt counts "h" from 0
+// to 23, so a 12-hour bar got a 24-hour lock ("14:02").
+function glanceTime(date, twelve) {
+  var d = date instanceof Date ? date : new Date(date)
+  var h = d.getHours()
+  var mm = (d.getMinutes() < 10 ? "0" : "") + d.getMinutes()
+  if (twelve) return (h % 12 || 12) + ":" + mm
+  return (h < 10 ? "0" : "") + h + ":" + mm
+}
+
+function age(timestamp, now) {
+  var minutes = Math.floor(Math.max(0, Number(now) - Number(timestamp || 0)) / 60000)
+  if (minutes < 1) return "now"
+  if (minutes < 60) return minutes + "m"
+  return Math.floor(minutes / 60) + "h"
+}
+
+// The rows the store holds: live.json then history.json, one JSON array per
+// line, merged and deduped by key (a toast on screen and its history entry
+// are the same notification), newest first.
+function parseRows(raw) {
+  var lines = String(raw || "").split("\n")
+  var rows = []
+  for (var i = 0; i < lines.length; i++) {
+    if (!lines[i].trim()) continue
+    var read
+    try { read = JSON.parse(lines[i]) } catch (e) { continue }
+    if (!Array.isArray(read)) continue
+    for (var j = 0; j < read.length; j++) rows.push(read[j])
+  }
+  return rows.sort(function(a, b) { return Number(b.ts || 0) - Number(a.ts || 0) })
+}
+
+// The shade's rows (see SHADE_LIMIT; a row with neither summary nor body is
+// skipped, as there).
+function shadeRows(raw) {
+  var rows = parseRows(raw)
+  var seen = {}
+  var out = []
+  for (var i = 0; i < rows.length && out.length < SHADE_LIMIT; i++) {
+    var e = rows[i]
+    if (!e || !e.key || seen[e.key]) continue
+    seen[e.key] = true
+    if (!String(e.summary || "").trim() && !String(e.body || "").trim()) continue
+    out.push(e)
+  }
+  return out
+}
+
+// The keys of every notification the store holds, as a set.
+function fileNames(raw) {
+  var rows = parseRows(raw)
+  var out = {}
+  for (var i = 0; i < rows.length; i++) out[String(rows[i].key || "")] = true
+  return out
+}
+
+// What still toasts while do-not-disturb is on (Delivery's rule): Omarchy's
+// own messages, and a critical notify-send.
+function bypassesDnd(row) {
+  var app = String((row && row.app) || "")
+  if (app === "omarchy-action") return true
+  return app === "notify-send" && Number(row.urgency) === CRITICAL
+}
+
+// Those rows as cards, one per notification, newest first. hideText shows
+// the app name and "Unlock to read" instead of the text, and no sender
+// picture. The detail beside the body is the age ("2m").
+function cards(raw, now, hideText, dnd) {
+  var rows = shadeRows(raw)
+  var out = []
+  for (var i = 0; i < rows.length; i++) {
+    var e = rows[i]
+    if (dnd && !bypassesDnd(e)) continue
+    var name = appName(e.app)
+    out.push({
+      app: name,
+      appIcon: e.appIcon,
+      image: hideText ? "" : String(e.image || ""),
+      glyph: e.glyph,
+      urgency: e.urgency,
+      timestamp: Number(e.ts || 0) * 1000,
+      summary: hideText ? name : (String(e.summary || "").trim() || name),
+      body: hideText ? "Unlock to read" : String(e.body || ""),
+      detail: age(Number(e.ts || 0) * 1000, now),
+      file: String(e.key || "")
+    })
+  }
+  return out
+}
+
+// The name a card goes by: Omarchy's own messages (omarchy-action)
+// as Omarchy, a bare notify-send or a nameless sender as Notifications.
+function appName(app) {
+  var name = String(app || "").trim()
+  if (name === "omarchy-action") return "Omarchy"
+  if (!name || name === "notify-send") return "Notifications"
+  return name
+}
+
+// The line under the cards for the notifications without one: "5 more from
+// Mail and GitHub", "5 more from Mail, GitHub and 2 others", each app named
+// once, newest first.
+function moreText(rest) {
+  if (!rest || rest.length === 0) return ""
+  var names = []
+  for (var i = 0; i < rest.length; i++) {
+    var app = String(rest[i].app || "")
+    if (app && names.indexOf(app) < 0) names.push(app)
+  }
+  if (names.length === 0) return rest.length + " more"
+  var from = names.length <= 2 ? names.join(" and ")
+    : names.slice(0, 2).join(", ") + " and " + (names.length - 2) + (names.length === 3 ? " other" : " others")
+  return rest.length + " more from " + from
+}
+
+// quiet.json's do-not-disturb flag: silenced notifications make no toast, so
+// the lock shows only what still toasts (cards).
+function doNotDisturb(raw) {
+  var read
+  try { read = JSON.parse(String(raw || "")) } catch (e) { return false }
+  return !!read && typeof read === "object" && read.dnd === true
+}
+
+// The home screen weather widget's last reading, which omamobile-shell
+// keeps in ~/.local/state/omamobile/weather.json:
+//   {"at": <ms since epoch>, "temperature": 12, "unit": "°C", "text": "Partly cloudy"}
+// Shown as "12°, partly cloudy"; nothing when absent, unreadable or older
+// than WEATHER_MAX_AGE_MS. The lock itself never asks the network.
+function weatherLine(raw, now) {
+  var w
+  try { w = JSON.parse(String(raw || "")) } catch (e) { return "" }
+  if (!w || typeof w.temperature !== "number" || !isFinite(w.temperature)) return ""
+  var at = Number(w.at || 0)
+  if (!(at > 0) || Number(now) - at > WEATHER_MAX_AGE_MS || at - Number(now) > 5 * 60 * 1000) return ""
+  var text = String(w.text || "").trim()
+  return Math.round(w.temperature) + "°" + (text ? ", " + text.charAt(0).toLowerCase() + text.slice(1) : "")
+}
+
+if (typeof module !== "undefined") {
+  module.exports = {
+    MAX_CARDS: MAX_CARDS,
+    SHADE_LIMIT: SHADE_LIMIT,
+    CRITICAL: CRITICAL,
+    WEATHER_MAX_AGE_MS: WEATHER_MAX_AGE_MS,
+    BAR_DEFAULT_FORMAT: BAR_DEFAULT_FORMAT,
+    twelveHour: twelveHour,
+    barClockFormat: barClockFormat,
+    timeFormat: timeFormat,
+    glanceTime: glanceTime,
+    age: age,
+    parseRows: parseRows,
+    shadeRows: shadeRows,
+    fileNames: fileNames,
+    bypassesDnd: bypassesDnd,
+    cards: cards,
+    appName: appName,
+    moreText: moreText,
+    doNotDisturb: doNotDisturb,
+    weatherLine: weatherLine
+  }
+}
