+        width: Math.min(Style.space(380), parent.width - Style.space(32))
+        spacing: 0
+
+        Text {
+          id: timeLabel
+          objectName: "lockGlanceTime"
+          width: parent.width
+          horizontalAlignment: Text.AlignHCenter
+          textFormat: Text.PlainText
+          text: Glance.glanceTime(clock.date, glance.twelveHour)
+          color: Commons.Color.lock.text
+          font.family: Style.font.family
+          font.weight: Font.Light
+          font.pixelSize: Math.round(Style.font.displayLarge * 3.7)
+          fontSizeMode: Text.HorizontalFit
+          minimumPixelSize: Style.font.display
+        }
+
+        Text {
+          objectName: "lockGlanceDate"
+          width: parent.width
+          topPadding: Style.space(14)
+          horizontalAlignment: Text.AlignHCenter
+          textFormat: Text.PlainText
+          text: Qt.formatDate(clock.date, "dddd, MMMM d")
+          color: Commons.Color.lock.text
+          font.family: Style.font.family
+          font.pixelSize: Style.font.heading
+          elide: Text.ElideRight
