#!/bin/sh
# SPDX-License-Identifier: MIT
# Hoerbuch-Sync: Unraid -> Phone, dann Bibliotheks-Rescan in Audiobookshelf.
# Laeuft als Timer (abs-sync.timer). Bricht still ab, wenn die Quelle nicht
# erreichbar ist (Heim-WLAN aus, kein Tailscale). Konfiguration (KEY=VALUE,
# nie als Shell ausgefuehrt):
#   /etc/audiobookshelf-sync.conf   Pfade, Host, Bibliothek (Vorlage im Paket)
#   /etc/audiobookshelf-sync.env    ABS_TOKEN, Modus 0600, nie ins Repo
set -eu

CONF=${ABS_SYNC_CONF:-/etc/audiobookshelf-sync.conf}
ENVF=${ABS_SYNC_ENV:-/etc/audiobookshelf-sync.env}

kv() { # kv FILE KEY -> Wert (letzte Zuweisung, ohne umschliessende Quotes)
  [ -r "$1" ] || return 0
  sed -n "s/^$2=//p" "$1" | tail -n 1 | sed 's/^"//; s/"$//'
}

UNRAID_HOST=$(kv "$CONF" UNRAID_HOST)
UNRAID_KEY=$(kv "$CONF" UNRAID_KEY)
SRC=$(kv "$CONF" SRC)
DEST=$(kv "$CONF" DEST)
STATE=$(kv "$CONF" STATE)
BWLIMIT=$(kv "$CONF" BWLIMIT)
MIN_FREE_GB=$(kv "$CONF" MIN_FREE_GB)
ABS_URL=$(kv "$CONF" ABS_URL)
ABS_LIBRARY_ID=$(kv "$CONF" ABS_LIBRARY_ID)
ABS_TOKEN=$(kv "$ENVF" ABS_TOKEN)

: "${BWLIMIT:=8000}" "${MIN_FREE_GB:=2}"
if [ -z "$UNRAID_HOST" ] || [ -z "$SRC" ] || [ -z "$DEST" ]; then
  echo "abs-sync: UNRAID_HOST, SRC und DEST fehlen in $CONF" >&2
  exit 2
fi

# Nur syncen, wenn die Quelle erreichbar ist (3 s Probe).
if ! ssh -i "$UNRAID_KEY" -o ConnectTimeout=3 -o BatchMode=yes "$UNRAID_HOST" true 2>/dev/null; then
  exit 0
fi

mkdir -p "$DEST"
free_gb=$(df -Pk "$DEST" | awk 'NR==2 { print int($4 / 1048576) }')
if [ "$free_gb" -lt "$MIN_FREE_GB" ]; then
  echo "abs-sync: zu wenig Platz ($free_gb GB frei, Minimum $MIN_FREE_GB GB) - uebersprungen" >&2
  exit 0
fi

# Quelle ist die Symlink-Farm auf dem Unraid, die kuratiert wird (nicht die ganze Bibliothek).
rsync -a --partial --bwlimit="$BWLIMIT" -e "ssh -i $UNRAID_KEY -o BatchMode=yes" \
  "$UNRAID_HOST:$SRC" "$DEST"

if [ -n "$STATE" ]; then
  mkdir -p "$(dirname -- "$STATE")"
  date -Iseconds > "$STATE"
fi

# Bibliothek neu scannen (ABS-API: POST /api/libraries/{id}/scan, Bearer-Token).
if [ -n "$ABS_URL" ] && [ -n "$ABS_LIBRARY_ID" ] && [ -n "$ABS_TOKEN" ]; then
  if ! curl -fsS -X POST -H "Authorization: Bearer $ABS_TOKEN" \
       "$ABS_URL/api/libraries/$ABS_LIBRARY_ID/scan" >/dev/null; then
    echo "abs-sync: Rescan fehlgeschlagen (Sync ist trotzdem fertig)" >&2
  fi
fi

echo "abs-sync: ok $(date -Iseconds)"
