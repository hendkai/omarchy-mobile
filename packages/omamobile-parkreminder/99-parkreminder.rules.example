# SPDX-License-Identifier: MIT
# udev rule for parkreminder. Shipped as an EXAMPLE only, not installed: the
# car's USB vendor/product ID is not known yet, and the trigger must not fire
# on the phone's own USB gadget. Copy to /etc/udev/rules.d/ once the ID is set.
#
#   ACTION=="remove", SUBSYSTEM=="usb", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="YYYY", \
#     RUN+="/usr/bin/systemd-run --no-block --uid=<USER> /usr/bin/parkreminder trigger"
#
# Run as the user (state lives in that user's home), not as root from udev.
# Set the IDs after `lsusb` in the car, with the phone plugged in.
