#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-parkreminder into DESTDIR. Activates nothing: the udev rule
# is shipped as an example only (see 99-parkreminder.rules.example).
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }

put() { install -d "$(dirname -- "$2")" && install -m "$1" -- "$3" "$2"; }
put 755 "$d/usr/bin/parkreminder" parkreminder.py
put 644 "$d/usr/share/parkreminder/parkreminder.conf.example" parkreminder.conf.example
put 644 "$d/usr/share/omamobile-parkreminder/version" version
