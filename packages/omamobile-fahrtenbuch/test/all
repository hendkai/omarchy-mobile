#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-fahrtenbuch suite: synthetic track only (a made-up straight line
# of 40 points, one minute apart); the database lives in a temp dir.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export FAHRTENBUCH_DB="$tmp/db/fahrtenbuch.sqlite"
# Keine Hardware: ohne mmcli faellt die modemmanager-Quelle auf den CSV-Import zurueck.
export OMAMOBILE_MMCLI=/nonexistent-mmcli

python3 -m unittest -q test_modemlocation || { echo "not ok - modemlocation Unit-Tests"; exit 1; }
echo "ok - modemlocation: NMEA, Bring-up-Gate, GNSS wieder aus (Unit-Tests)"

python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" fahrtenbuch.py
echo "ok - fahrtenbuch.py parses"

# 40 Punkte, je 1 min, 0.001 Grad Breite (~111 m) -> eine Fahrt von ~4.4 km
python3 - "$tmp/track.csv" <<'PY'
import sys
from datetime import datetime, timedelta
t0 = datetime(2026, 11, 1, 10, 0, 0)
with open(sys.argv[1], "w") as f:
    for i in range(40):
        f.write(f"{(t0 + timedelta(minutes=i)).isoformat()},{48.0 + i * 0.001:.6f},9.000000\n")
PY

python3 fahrtenbuch.py import "$tmp/track.csv" | grep -q "1 neue Fahrten" \
  || { echo "not ok - erster Import: 1 Fahrt erwartet"; exit 1; }
echo "ok - Import: genau 1 Fahrt aus dem synthetischen Track"

python3 fahrtenbuch.py import "$tmp/track.csv" | grep -q "0 neue Fahrten" \
  || { echo "not ok - zweiter Import darf nichts doppelt speichern"; exit 1; }
echo "ok - zweiter Import dedupliziert"

# Live-Fahrt (start/end, vom car-Profil gerufen) ohne Modem: GNSS aus, also
# ohne Koordinaten. Keine Strecke, Zweck offen.
python3 fahrtenbuch.py start --gps-source none | grep -q "Fahrt gestartet" \
  || { echo "not ok - start ohne GPS muss die Fahrt oeffnen"; exit 1; }
python3 fahrtenbuch.py end --gps-source none | grep -q "Strecke keine Daten" \
  || { echo "not ok - end ohne GPS muss die Fahrt ohne Strecke speichern"; exit 1; }
python3 fahrtenbuch.py list | grep -q "keine Strecke: Live-Fahrt ohne Track" \
  || { echo "not ok - Live-Fahrt muss als Notiz 'keine Strecke' zeigen"; exit 1; }
python3 fahrtenbuch.py end --gps-source none | grep -q "keine laufende Fahrt" \
  || { echo "not ok - end ohne offene Fahrt darf nichts speichern"; exit 1; }
echo "ok - start/end ohne GPS: Live-Fahrt ohne Strecke, zweites end ohne offene Fahrt ist leer"

# Export: Finanzamt-Format (detail + summary), Zeile der Track-Fahrt mit ~4,4 km.
python3 fahrtenbuch.py export 2026-11 --out "$tmp/export" >"$tmp/export.out" \
  || { echo "not ok - Export laeuft nicht durch"; exit 1; }
for f in Fahrtenbuch_2026-11_detail.csv Fahrtenbuch_2026-11_summary.csv Fahrtenbuch_2026-11.html Fahrtenbuch_2026-11.pdf; do
  [[ -s "$tmp/export/$f" ]] || { echo "not ok - Export fehlt: $f"; exit 1; }
done
python3 - "$tmp/export/Fahrtenbuch_2026-11_detail.csv" <<'PY'
import csv, sys
rows = list(csv.reader(open(sys.argv[1], encoding="utf-8-sig"), delimiter=";"))
assert rows[0] == ["Datum", "Beginn", "Ende", "km", "Zweck", "Ziel/Notiz", "Status"], rows[0]
track = [r for r in rows[1:] if r[0] == "01.11.2026"]
assert len(track) == 1, rows
km = float(track[0][3].replace(",", "."))
assert 4.0 < km < 4.8, km
assert track[0][4] == "offen", track[0]
PY
echo "ok - Export: detail-CSV mit der Track-Fahrt, ~4.4 km, Zweck offen; summary, html, pdf da"

# install stages every file into a scratch root (no host paths touched)
stage="$tmp/stage"
./install "$stage"
for f in usr/bin/fahrtenbuch usr/lib/omamobile-fahrtenbuch/modemlocation.py usr/share/omamobile-fahrtenbuch/version; do
  [[ -f "$stage/$f" ]] || { echo "not ok - install stages $f"; exit 1; }
done
echo "ok - install stages all 3 files (inkl. modemlocation.py)"
