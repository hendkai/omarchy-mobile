#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-fahrtenbuch into DESTDIR. Activates nothing.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }

put() { install -d "$(dirname -- "$2")" && install -m "$1" -- "$3" "$2"; }
put 755 "$d/usr/bin/fahrtenbuch" fahrtenbuch.py
put 644 "$d/usr/lib/omamobile-fahrtenbuch/modemlocation.py" modemlocation.py
put 644 "$d/usr/share/omamobile-fahrtenbuch/version" version
