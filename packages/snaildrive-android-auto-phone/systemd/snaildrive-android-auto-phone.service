[Unit]
Description=SnailDrive Android-Auto-Phone-Seite (Navi-Bruecke zum AA-Kanal)
Documentation=file:///usr/share/doc/snaildrive-android-auto-phone/README.md
# Startet nur, wenn der Auto-Profil-Trigger (carprofile navi-aa) oder Hendrik
# ihn anfordert. Kein WantedBy: die Unit ist bewusst NICHT aktiviert.
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=-/etc/snaildrive-android-auto-phone/snaildrive-aac-phoneside.conf
ExecStart=/usr/bin/snaildrive-aac-phoneside serve
Restart=on-failure
RestartSec=5
DynamicUser=yes
RuntimeDirectory=snaildrive
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/snaildrive

[Install]
# Bewusst leer: keine Aktivierung beim Boot, nur ueber das Auto-Profil.
