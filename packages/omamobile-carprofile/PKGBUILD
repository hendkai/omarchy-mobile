# SPDX-License-Identifier: MIT
# omamobile-carprofile: Auto-Profil `car` fuer Omarchy Mobile (EQB/spacewar).
# AOA-Erkennung (18d1:2d00/2d01), Anstecken/Abstecken, udev-Trigger und
# Dispatcher (root -> systemd-run --user --machine). Bündelt nichts: das
# car-Profil ist aktiviert erst nach Hendriks OK am Geraet (kein Phone-I/O
# ohne OK). Hier nur die Dateien bereitstellen, die ein Geräte-Operator zur
# Aktivierung der udev-Regel braucht.
pkgname=omamobile-carprofile
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Auto-Profil car: AOA-Erkennung (18d1:2d00/2d01), Anstecken/Abstecken, udev-Trigger und Dispatcher (root -> systemd-run --user --machine)"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(python)
checkdepends=(python-pytest)
source=()

package() {
  "$startdir/install" "$pkgdir"
}

check() {
  "$startdir/test/all"
}
