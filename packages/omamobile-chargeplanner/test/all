#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-chargeplanner suite: no phone, no network, no 50 MB register.
# A synthetic register (fake stations, made-up coordinates) drives the tests.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export CHARGEPLANNER_DATA_DIR="$tmp" CHARGEPLANNER_CONFIG="$tmp/none.conf"

python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" chargeplanner.py
echo "ok - chargeplanner.py parses"

python3 - "$tmp" <<'PY'
import sys
out = sys.argv[1]
cols = ["Ladeeinrichtungs-ID"] + [f"c{i}" for i in range(1, 45)]
def row(sid, status, lat, lon, kw, conn):
    r = [""] * 45
    r[0], r[1], r[2], r[3], r[4], r[5] = sid, "TestBetreiber", "Testsaeule " + sid, status, "Schnellladung", "1"
    r[6] = str(kw).replace(".", ",")
    r[11], r[12] = "Teststadt", "12345"
    r[15], r[16] = str(lat).replace(".", ","), str(lon).replace(".", ",")
    r[24], r[25] = conn, str(kw).replace(".", ",")
    return ";".join(r)
lines = [";".join(cols),
         row("T-A", "In Betrieb", 48.0005, 9.0005, 300, "CCS"),   # nah, CCS, in Betrieb
         row("T-B", "Außer Betrieb", 48.0005, 9.0005, 300, "CCS"),  # nicht in Betrieb
         row("T-C", "In Betrieb", 48.5, 9.5, 150, "CCS")]         # weit weg
open(f"{out}/ladesaeulenregister.csv", "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY

# Vorhandene Datei, keine URL: kein Download, kein Fehler.
python3 chargeplanner.py --refresh-register >/dev/null 2>&1 \
  || { echo "not ok - refresh mit vorhandener Datei ohne URL"; exit 1; }
echo "ok - refresh mit vorhandener Datei ohne URL bricht nicht ab"

# Abfrage: nur T-A (in Betrieb, im Radius), als CCS markiert, Zaehler stimmt.
python3 chargeplanner.py 48.0 9.0 --soc 40 > "$tmp/out.json"
python3 - "$tmp/out.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
assert d["stations_total"] == 2, d                # T-A, T-C (T-B ist außer Betrieb)
ids = [s["id"] for s in d["stations"]]
assert ids == ["T-A"], ids
assert d["stations"][0]["ccs"] is True, d
PY
echo "ok - Abfrage: nur die in Betrieb befindliche Nahstation, CCS erkannt"

# --- SoC-Quelle mercedes: read-only Statusdatei, synthetisch, kein Netz ---
# The status file mimics the connector's redacted status.json (no VIN, no
# token). Every case runs against the synthetic register above.
now=$(python3 -c 'import time; print(int(time.time() * 1000))')
st="$tmp/status.json"
printf '{"state":"ok","soc_percent":40,"range_km":150,"written_at_ms":%s}' "$now" >"$st"

expect_fail() { # expect_fail "<stderr grep>" command...
  local want=$1; shift
  if "$@" >/dev/null 2>"$tmp/err"; then return 1; fi
  grep -q -- "$want" "$tmp/err"
}

python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$st" >"$tmp/m.json"
python3 - "$tmp/m.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
assert d["soc_pct"] == 40.0 and d["soc_source"] == "mercedes", d
assert "vin" not in json.dumps(d).lower(), d
PY
echo "ok - SoC aus der Mercedes-Statusdatei, Quelle steht im Ergebnis, keine VIN-Felder"

printf '{"state":"no-session","written_at_ms":%s}' "$now" >"$tmp/nosess.json"
python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/nosess.json" --soc 40 >"$tmp/fb.json" 2>"$tmp/fb.err"
python3 - "$tmp/fb.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
assert d["soc_pct"] == 40.0 and d["soc_source"] == "manual-fallback", d
PY
echo "ok - Connector ohne Sitzung (no-session): --soc als Fallback"

expect_fail "--soc" python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/nosess.json" \
  || { echo "not ok - no-session ohne --soc muss mit Hinweis abbrechen"; exit 1; }
echo "ok - Connector ohne Sitzung ohne --soc: Abbruch mit Hinweis"

printf '{"state":"ok","soc_percent":null,"written_at_ms":%s}' "$now" >"$tmp/null.json"
expect_fail "Ladestand" python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/null.json" \
  || { echo "not ok - soc_percent null darf nie zu 0 werden"; exit 1; }
python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/null.json" --soc 30 >"$tmp/n.json" 2>/dev/null
python3 -c "import json,sys; d=json.load(open(sys.argv[1])); assert d['soc_pct']==30.0, d" "$tmp/n.json"
echo "ok - soc_percent null: kein Ladestand 0 %, sondern Fehler bzw. --soc"

expect_fail "Statusdatei nicht lesbar" python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/none.json" \
  || { echo "not ok - fehlende Statusdatei ohne --soc muss abbrechen"; exit 1; }
echo "ok - fehlende Statusdatei: klare Meldung, kein erfundener SoC"

printf '{"state":"ok","soc_percent":60,"written_at_ms":%s}' "$((now - 7200000))" >"$tmp/old.json"
expect_fail "alt" python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/old.json" \
  || { echo "not ok - veralteter Status ohne --soc muss abbrechen"; exit 1; }
python3 chargeplanner.py 48.0 9.0 --soc-source mercedes --mercedes-status-cache "$tmp/old.json" --soc 35 >"$tmp/o.json" 2>"$tmp/o.err"
grep -q "alt" "$tmp/o.err" || { echo "not ok - veralteter Status mit --soc braucht Hinweis"; exit 1; }
python3 -c "import json,sys; d=json.load(open(sys.argv[1])); assert d['soc_pct']==35.0 and d['soc_source']=='manual-fallback', d" "$tmp/o.json"
echo "ok - veralteter Mercedes-Status (>30 min): ohne --soc Abbruch, mit --soc Fallback"

printf 'SOC_SOURCE=mercedes\nMERCEDES_STATUS_CACHE=%s\n' "$st" >"$tmp/mc.conf"
CHARGEPLANNER_CONFIG="$tmp/mc.conf" python3 chargeplanner.py 48.0 9.0 >"$tmp/c.json"
python3 -c "import json,sys; d=json.load(open(sys.argv[1])); assert d['soc_source']=='mercedes' and d['soc_pct']==40.0, d" "$tmp/c.json"
echo "ok - SOC_SOURCE und MERCEDES_STATUS_CACHE aus der Konfiguration"

printf 'SOC_SOURCE=bluetooth\n' >"$tmp/bad.conf"
expect_fail "unbekannt" env CHARGEPLANNER_CONFIG="$tmp/bad.conf" python3 chargeplanner.py 48.0 9.0 \
  || { echo "not ok - unbekannte SOC_SOURCE muss abbrechen"; exit 1; }
echo "ok - unbekannte SOC_SOURCE: Abbruch"

expect_fail "--soc" python3 chargeplanner.py 48.0 9.0 --soc-source manual \
  || { echo "not ok - manual ohne --soc muss abbrechen"; exit 1; }
echo "ok - manual ohne --soc: Abbruch mit Hinweis"

# Ohne Datei und ohne URL: klare Meldung, Abbruch mit Code != 0.
rm -f "$tmp/ladesaeulenregister.csv"
if python3 chargeplanner.py 48.0 9.0 --soc 40 >/dev/null 2>"$tmp/err"; then
  echo "not ok - ohne Register und ohne URL muss es abbrechen"; exit 1
fi
grep -q "REGISTER_URL" "$tmp/err" || { echo "not ok - Meldung nennt REGISTER_URL nicht"; exit 1; }
echo "ok - ohne Register und ohne URL: Abbruch mit Hinweis auf /etc/chargeplanner.conf"

# --refresh-register mit unerreichbarer URL und veraltetem lokalem Register:
# ist ein Fehler (Exit != 0), damit der monatliche Timer den Grund meldet.
python3 - "$tmp" <<'PY'
import os
import sys
import time
from pathlib import Path
tmp = Path(sys.argv[1])
reg = tmp / "ladesaeulenregister.csv"
reg.write_text("SILENTE-DUMMY;keine;Station\n", encoding="utf-8")
old = time.time() - 40 * 86400
os.utime(reg, (old, old))
PY
UNREACH="file://{tmp}/does-not-exist.csv"
CHARGEPLANNER_REGISTER_URL="$UNREACH" CHARGEPLANNER_DATA_DIR="$tmp" python3 chargeplanner.py --refresh-register >/dev/null 2>"$tmp/refresh.err" || rc=$?
test $rc -ne 0 || { echo "not ok - veraltetes Register + unerreichbare URL muss Fehler sein"; exit 1; }
grep -q "aelter als 25 Tage" "$tmp/refresh.err" || { echo "not ok - Fehlermeldung nennt kein Ablaufdatum"; exit 1; }
echo "ok - refresh mit veraltetem Register + unerreichbarer URL: Fehler, Exit != 0"

# install stages every file into a scratch root (no host paths touched)
stage="$tmp/stage"
./install "$stage"
for f in usr/bin/chargeplanner etc/chargeplanner.conf usr/lib/systemd/system/chargeplanner-register.service usr/lib/systemd/system/chargeplanner-register.timer usr/share/omamobile-chargeplanner/version; do
  [[ -f "$stage/$f" ]] || { echo "not ok - install stages $f"; exit 1; }
done
echo "ok - install stages all 5 files"
