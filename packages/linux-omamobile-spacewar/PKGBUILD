# SPDX-License-Identifier: MIT
# Maintainer: Snailberg port for spacewar (Nothing Phone 1)
#
# The spacewar kernel as a pacman package: arm64 Image, its modules and the
# board DTB, packed from a finished kernel-spacewar build. Nothing compiles
# here: `./stage KERNEL_OUT` first copies kernel-spacewar/out (v7.2.2-sc7280
# + the 52 woodyst patches; CONFIG_LOCALVERSION -sc7280-omamobile1, so the
# module directory never collides with the gs201 kernel's) into prebuilt/.
# pkgver comes from the staged release (lib/pkgver), pkgrel from the version
# file (packaging changes only).
#
# Local-only by design: the sc7280 tree is not the published omamobile
# branch, so ./stage checks provenance magics and checksums instead of a
# release tag, and this is built with tools/build-packages --local spacewar.
# linux-omamobile stays the release kernel; the two conflict (they share
# /usr/share/omamobile/linux and the boot-update flow).
_prebuilt=${LINUX_OMAMOBILE_SPACEWAR_PREBUILT:-${startdir:-.}/prebuilt}
pkgname=linux-omamobile-spacewar
pkgver=$("${startdir:-.}/lib/pkgver" "$(cat "$_prebuilt/kernel.release" 2>/dev/null)" 2>/dev/null || echo 0)
pkgrel=$(cat "${startdir:-.}/version")
pkgdesc="The Omarchy Mobile kernel for the Nothing Phone (1): arm64 Image, modules and the spacewar DTB (sc7280-mainline v7.2.2-sc7280 + 52 patches)"
arch=(aarch64)
url="https://github.com/sc7280-mainline/linux"
license=(GPL-2.0-only)
depends=(kmod omamobile-boot-update)
makedepends=(zstd gzip)
checkdepends=(zstd)
conflicts=(linux-omamobile)
# The Image is not ELF and the modules are stripped already (and must stay
# as built); no debug package
options=(!strip !debug)

check() {
  "$startdir/test/all"
}

package() {
  [[ $pkgver != 0 ]] || { echo "no staged kernel in $_prebuilt (run: ./stage KERNEL_OUT)" >&2; return 1; }
  "$startdir/install" "$pkgdir" "$_prebuilt"
}
