#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage linux-omamobile-spacewar into DESTDIR from a prebuilt/ directory
# that ./stage filled, in Arch Linux ARM's layout (the spacewar counterpart
# of linux-omamobile/install):
#
#   /usr/lib/modules/<release>/vmlinuz           the arm64 Image (unpacked from Image.gz)
#   /usr/lib/modules/<release>/kernel/...        the stripped modules
#   /usr/lib/modules/<release>/modules.order, modules.builtin*
#   /usr/lib/modules/<release>/dtbs/qcom/*.dtb   the board DTB
#   /usr/lib/modules/<release>/pkgbase           linux-omamobile-spacewar
#   /usr/share/omamobile/linux/kernel.release    <release> (same marker path as
#       linux-omamobile; the packages conflict, so both never coexist)
#   /usr/share/omamobile/linux/SOURCE            the sc7280 tree's provenance
#
# depmod's files are left out as Arch's kernels leave them out: kmod's
# 60-depmod hook makes them on the phone, and omamobile-boot-update refuses
# a release depmod hasn't seen. No initramfs and no boot images here: the
# boot image for qcom-abl-v2 comes from `bin/omamobile images` (P4 wires
# omamobile-boot-update for it).
#
#   ./install DESTDIR [PREBUILT]     (PREBUILT: default prebuilt/)
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR [PREBUILT]}
pre=${2:-prebuilt}
die() { printf 'linux-omamobile-spacewar install: %s\n' "$*" >&2; exit 1; }
[[ $d == /* && $d != "/" ]] || die "use an absolute staging directory"
[[ -f $pre/kernel.release && -f $pre/SHA256SUMS ]] \
  || die "no staged kernel in $pre (run: packages/linux-omamobile-spacewar/stage KERNEL_OUT)"
(cd "$pre" && sha256sum --quiet --strict -c SHA256SUMS) || die "$pre fails its checksums"
for f in Image.gz modules.tar.zst kernel.release SOURCE; do
  grep -cE "  $f$" "$pre/SHA256SUMS" >/dev/null || die "$pre/SHA256SUMS does not cover $f"
done
rel=$(cat "$pre/kernel.release")
./lib/pkgver "$rel" >/dev/null || exit 1
commit=$(sed -n 's/^commit \([0-9a-f]\{7,40\}\)$/\1/p' "$pre/SOURCE")
[[ -n $commit && $rel == *"-g$commit"* ]] \
  || die "$pre/SOURCE does not name the commit $rel was built from"
[[ $(od -An -tx1 -N2 "$pre/Image.gz" | tr -d ' \n') == 1f8b ]] || die "$pre/Image.gz is not gzip"
[[ $(gzip -dc "$pre/Image.gz" | od -An -tx1 -j56 -N4 | tr -d ' \n') == 41524d64 ]] \
  || die "$pre/Image.gz does not unpack to an arm64 Image"

m=$d/usr/lib/modules
mkdir -p "$m"
# Only the release's own directory comes out of the tarball
top=$(tar --zstd -tf "$pre/modules.tar.zst" | sed 's|^\./||; s|/.*||' | sort -u)
[[ $top == "$rel" ]] || die "modules.tar.zst holds '$top', not $rel"
tar --zstd -xf "$pre/modules.tar.zst" -C "$m" --no-same-owner --no-same-permissions
r=$m/$rel
rm -f "$r/build" "$r/source"
for f in modules.alias modules.alias.bin modules.builtin.alias.bin modules.builtin.bin modules.dep modules.dep.bin \
         modules.devname modules.softdep modules.symbols modules.symbols.bin modules.weakdep; do
  rm -f "$r/$f"
done
[[ -f $r/modules.order ]] || die "the modules have no modules.order"
find "$r" -name '*.ko*' -print -quit | grep -c . >/dev/null || die "the modules tarball has no modules"
find "$r" -type l | grep -c . >/dev/null && die "the module tree holds symlinks"
# vmlinuz is the uncompressed Image, like linux-omamobile's (the qcom-abl-v2
# boot image re-compresses from it / from Image.gz in bin/omamobile images)
gzip -dc "$pre/Image.gz" > "$r/vmlinuz"
[[ $(od -An -tx1 -j56 -N4 "$r/vmlinuz" | tr -d ' \n') == 41524d64 ]] || die "unpacked vmlinuz lost the arm64 magic"
(cd "$pre/dtbs" && find . -name '*.dtb' -type f | sed 's|^\./||' | LC_ALL=C sort) | while IFS= read -r f; do
  install -Dm644 "$pre/dtbs/$f" "$r/dtbs/$f"
done
find "$r/dtbs" -name '*.dtb' -print -quit 2>/dev/null | grep -c . >/dev/null || die "no DTBs in $pre/dtbs"
echo linux-omamobile-spacewar > "$r/pkgbase"
chmod -R u+rwX,go+rX,go-w "$r"
install -Dm644 "$pre/SOURCE" "$d/usr/share/omamobile/linux/SOURCE"
printf '%s\n' "$rel" > "$d/usr/share/omamobile/linux/kernel.release"
chmod 644 "$d/usr/share/omamobile/linux/kernel.release"
install -Dm644 version "$d/usr/share/omamobile/linux/version"
